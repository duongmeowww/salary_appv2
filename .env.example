# Cấu hình môi trường cho ứng dụng Salary
# Copy file này thành .env và điều chỉnh các giá trị cho phù hợp

# Chế độ chạy (development hoặc production)
FLASK_ENV=production

# Secret key cho session (thay đổi giá trị này cho bảo mật)
# Tạo random: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Tên công ty và slogan hiển thị trên giao diện
COMPANY_NAME=Công ty May mặc
COMPANY_SLOGAN=Hệ thống quản lý lương công nhân

# Database
# Mặc định sử dụng SQLite, có thể thay đổi thành MySQL hoặc PostgreSQL
# MySQL: mysql://username:password@localhost/database_name
# PostgreSQL: postgresql://username:password@localhost/database_name
SQLALCHEMY_DATABASE_URI=

# Debug mode (False cho production)
DEBUG=False

# Host và port (cho development)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Max upload file size (bytes, mặc định 16MB)
MAX_CONTENT_LENGTH=16777216

# Session timeout (tính bằng ngày)
PERMANENT_SESSION_LIFETIME=7

# Mật khẩu cho tài khoản admin đầu tiên (dùng bởi lệnh: flask init-db)
# Nếu bỏ trống, hệ thống sẽ sinh mật khẩu ngẫu nhiên và in ra màn hình
ADMIN_PASSWORD=
